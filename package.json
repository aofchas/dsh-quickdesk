{
  "name": "dsh-quickdesk",
  "version": "1.2.1",
  "description": "QuickDesk（快捷桌面）— a global-hotkey desktop assistant for DeepSeek Harness: in-app settings page, bilingual completion-first task protocol, hard step budget, one-line status HUD and an in-app diagnostics report.",
  "type": "module",
  "main": "quickdesk.mjs",
  "exports": {
    ".": "./quickdesk.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "test:unit": "node scripts/selftest.mjs",
    "test:release": "node scripts/verify-release.mjs",
    "selftest": "node scripts/selftest.mjs",
    "verify": "node scripts/selftest.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "prepublishOnly": "node scripts/test-all.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "desktop-automation",
    "global-shortcut",
    "hotkey",
    "computer-use",
    "uia",
    "windows"
  ],
  "author": "aofchas (aofchas) <20648453+aofchas@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aofchas/dsh-quickdesk.git"
  },
  "homepage": "https://github.com/aofchas/dsh-quickdesk#readme",
  "bugs": {
    "url": "https://github.com/aofchas/dsh-quickdesk/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "os": [
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "quickdesk.mjs",
    "client.js",
    "compat.mjs",
    "cordis.patch.yml",
    "scripts/launcher.ps1",
    "scripts/approval-popup.ps1",
    "scripts/collect-diagnostics.ps1",
    "scripts/selftest.mjs",
    "scripts/verify-release.mjs",
    "locale/*.json",
    "icon.svg",
    "skills/**",
    "docs/*.md",
    "docs/assets/*.png",
    "CHANGELOG.md",
    "SECURITY.md",
    "README.md",
    "README.en.md",
    "COMPATIBILITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
